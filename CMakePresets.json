{
    "version": 6,

    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },

    "configurePresets": [
      {
        "name": "windows-clang-debug",
        "displayName": "Windows Clang-cl Debug",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build/windows-clang-debug",
        "cacheVariables": {

          "CMAKE_CXX_COMPILER": "clang-cl",
          "CMAKE_BUILD_TYPE": "Debug",
          "CPPENV_BUILD_TESTS": "ON"
        }
      },

      {
        "name": "windows-clang-release",
        "displayName": "Windows Clang-cl Release",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/build/windows-clang-release",
        "cacheVariables": {

          "CMAKE_CXX_COMPILER": "clang-cl",
          "CMAKE_BUILD_TYPE": "Release",
          "CPPENV_BUILD_TESTS": "ON"
        }
      }


    ],

    "buildPresets": [
      {
        "name": "windows-clang-debug",
        "configurePreset": "windows-clang-debug"
      },

      {
        "name": "windows-clang-release",
        "configurePreset": "windows-clang-release"
      }

    ],

    "testPresets": [
      {
        "name": "windows-clang-debug",
        "configurePreset": "windows-clang-debug",
        "output": {
          "outputOnFailure": true
        }
      },

      {
        "name": "windows-clang-release",
        "configurePreset": "windows-clang-release",
        "output": {
          "outputOnFailure": true
        }
      }

    ],

    "workflowPresets": [
      {
        "name": "windows-clang-debug",
        "displayName": "Windows Clang-cl Debug - Full",
        "steps": [
          {
            "type": "configure",
            "name": "windows-clang-debug"
          },
          {
            "type": "build",
            "name": "windows-clang-debug"
          },
          {
            "type": "test",
            "name": "windows-clang-debug"
          }
        ]
      },

      {
        "name": "windows-clang-release",
        "displayName": "Windows Clang-cl Release - Full",
        "steps": [
          {
            "type": "configure",
            "name": "windows-clang-release"
          },
          {
            "type": "build",
            "name": "windows-clang-release"
          },
          {
            "type": "test",
            "name": "windows-clang-release"
          }
        ]
      }

    ]
}